# Copy to k8s/base/secret.env for local development.
# k8s/base/secret.env is ignored by git and used by `make kube-secrets`.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://mldlc:change-me@db:5432/mldlc
MINIO_ROOT_USER=change-me-user
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=change-me-user
MINIO_SECRET_KEY=change-me
GITEA_ADMIN_TOKEN=
GRAFANA_ADMIN_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_DATASOURCE_PASSWORD=change-me
SECRET_KEY=change-me
